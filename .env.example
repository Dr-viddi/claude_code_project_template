# Copy to .env. Never commit the real .env.

# LLM
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Data stores
DATABASE_URL=postgresql://app:app@db:5432/app
REDIS_URL=redis://cache:6379/0
VECTOR_BACKEND=pgvector

# Observability
LOG_LEVEL=INFO

# MCP
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
PROJECT_ROOT=.
