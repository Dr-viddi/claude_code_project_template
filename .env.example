# Copy to .env and edit. The real .env is gitignored - never commit secrets.
# app/config.py is the single consumer of these. Defaults make the app run offline.

# LLM. "echo" is the offline deterministic stub; switch to "anthropic" once you
# install the extra and set a key.
LLM_PROVIDER=echo
LLM_MODEL=claude-sonnet-4-6
ANTHROPIC_API_KEY=

# Stores. Leave empty for in-memory backends (fine for dev). Set to enable Redis/DB.
REDIS_URL=
DATABASE_URL=
VECTOR_BACKEND=memory

# Runtime defense harness (security/). audit | human_in_the_loop | block
HARNESS_ENABLED=true
CONTROL_MODE=audit
CONTRACT_PATH=security/contract.yaml
HARNESS_API_KEY=

# Observability / alerts
LOG_LEVEL=INFO
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=

# Agent loop guard
MAX_AGENT_STEPS=4

# MCP - referenced by .mcp.json
GITHUB_TOKEN=
SLACK_BOT_TOKEN=
SLACK_TEAM_ID=
PROJECT_ROOT=.
